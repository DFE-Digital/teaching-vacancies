- content_for(:page_title_prefix) { t("omniauth_callbacks.sign_in_error_title") }

h1.govuk-heading-xl = t("omniauth_callbacks.sign_in_error_heading")

p.govuk-body = t("omniauth_callbacks.unknown_organisation_html", organisation: @org_name, organisation_type: @org_type)

