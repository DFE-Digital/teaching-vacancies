doctype html
html.govuk-template.app-html-class lang="en" style="--print-footer-text: #{content_for(:print_footer_text).to_s.to_json}"
  head
    = render "layouts/head_meta"
    = render "layouts/head_links"
    title #{content_for :page_title_prefix} - #{t("app.title")} - GOV.UK
    = stylesheet_link_tag "application", media: "all"

  body.govuk-template__body
    main#print-content.print-layout role="main"
      = yield
