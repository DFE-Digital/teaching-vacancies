.divider-bottom
  .govuk-heading-m = t("jobs.no_jobs.heading")
  p.govuk-body
    = t("jobs.no_jobs.intro")
    ul.govuk-list.govuk-list--bullet
      - t("jobs.no_jobs.suggestions").each do |list_item|
        li = list_item

.divider-bottom
  = render "vacancies/search/no_results_suggestions_list", no_results_suggestions: no_results_suggestions

span.govuk-heading-m
  = t("subscriptions.link.no_search_results.text_html",
      link_to: govuk_link_to(t("subscriptions.link.no_search_results.link"), new_subscription_path(search_criteria: vacancies_search.active_criteria)))

p class="govuk-!-margin-1"
  = t("subscriptions.benefits.title")
  ul.govuk-list.govuk-list--bullet
    - t("subscriptions.benefits.list").each do |list_item|
      li = list_item
