.govuk-grid-row.banner-buttons
  - if (vacancy.enable_job_applications? || vacancy.uploaded_form?) && vacancy.live?
    .govuk-grid-column-one-third
      - if job_application
        - if job_application.draft?
          = button_to t("jobseekers.job_applications.banner_links.draft"), jobseekers_job_application_apply_path(job_application), method: :get, class: "banner-button-component__button icon icon--left icon--green-tick"
        - elsif job_application.withdrawn?
          = button_to t("jobseekers.job_applications.banner_links.withdrawn"), jobseekers_job_application_path(job_application), class: "banner-button-component__button icon icon--left icon--green-tick"
        - else
          = button_to t("jobseekers.job_applications.banner_links.submitted"), jobseekers_job_application_path(job_application), class: "banner-button-component__button icon icon--left icon--green-tick"
      - elsif vacancy.teaching_or_middle_leader_role?
        / possible ab-test for TRN prompt for these role types
        / can't do it unless jobseeker is signed in at this point
        - trn_on_apply_variant = current_jobseeker.present? ? field_test(:trn_on_apply) : "apply"
        - if trn_on_apply_variant == "apply"
          - if vacancy.uploaded_form?
            = button_to t("jobseekers.job_applications.banner_links.apply"), jobseekers_job_job_application_path(vacancy.id), class: "banner-button-component__button icon icon--left icon--apply"
          - else
            = button_to t("jobseekers.job_applications.banner_links.apply"), new_jobseekers_job_job_application_path(vacancy.id), method: :get, class: "banner-button-component__button icon icon--left icon--apply"
        - else
          = button_to t("jobseekers.job_applications.banner_links.apply"), trn_interstitial_job_path(vacancy.id), method: :get, class: "banner-button-component__button icon icon--left icon--apply"
      - elsif vacancy.uploaded_form?
        = button_to t("jobseekers.job_applications.banner_links.apply"), jobseekers_job_job_application_path(vacancy.id), class: "banner-button-component__button icon icon--left icon--apply"
      - else
        = button_to t("jobseekers.job_applications.banner_links.apply"), new_jobseekers_job_job_application_path(vacancy.id), method: :get, class: "banner-button-component__button icon icon--left icon--apply"

  .govuk-grid-column-one-third
    = button_to t("jobs.alert.similar.terse"), new_subscription_path, params: { search_criteria: invented_job_alert_search_criteria, vacancy_id: vacancy.id }, method: :get, class: "banner-button-component__button icon icon--left icon--alert-blue"

  - if job_application.nil?
    .govuk-grid-column-one-third
      - if saved_job
        = button_to t("jobseekers.saved_jobs.saved"), jobseekers_saved_job_path(vacancy.id, saved_job), method: :delete, class: "banner-button-component__button icon icon--left icon--saved"
      - else
        = button_to t("jobseekers.saved_jobs.save"), new_jobseekers_saved_job_path(vacancy.id), method: :get, class: "banner-button-component__button icon icon--left icon--save"
