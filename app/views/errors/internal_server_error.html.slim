- content_for :page_title_prefix, t("error_pages.server_error")

.govuk-grid-row
  .govuk-grid-column-two-thirds
    h1.govuk-heading-xl = t("error_pages.server_error")
    p.govuk-body = t("error_pages.server_error_working")
    p.govuk-body = t("error_pages.server_error_contact_html", email: govuk_mail_to(t("help.email"), t("help.email")))
    - if @error_id.present?
      p.govuk-body
        = t("error_pages.server_error_include_number")
      = govuk_inset_text(text: @error_id)
