- content_for :page_title_prefix, t(".page_title")

= govuk_back_link text: t("buttons.back"), href: new_organisation_job_shortlist_share_path(vacancy.id, job_application_ids: @job_application_ids)

.govuk-grid-row
  .govuk-grid-column-two-thirds
    span.govuk-caption-l = vacancy.job_title
    h1.govuk-heading-l = t(".heading")

    = govuk_summary_list do |summary_list|
      - summary_list.with_row do |row|
        - row.with_key text: t(".recipient")
        - row.with_value text: @form.email
        - row.with_action text: t("buttons.change"), href: new_organisation_job_shortlist_share_path(vacancy.id, job_application_ids: @job_application_ids), visually_hidden_text: t(".recipient")

    h2.govuk-heading-m = t(".applications_heading", count: @job_applications.count)

    ul.govuk-list.govuk-list--bullet
      - @job_applications.each do |job_application|
        li = job_application.name

    = govuk_warning_text text: t(".sensitive_information_warning")

    = form_with model: @form,
      url: organisation_job_shortlist_share_path(vacancy.id),
      method: :post do |form|
      = form.hidden_field :email

      - @job_application_ids.each do |job_application_id|
        = form.hidden_field :job_application_ids, multiple: true, value: job_application_id

      = form.govuk_submit t(".send")

    p.govuk-body = govuk_link_to t("buttons.cancel"), organisation_job_job_applications_path(vacancy.id, anchor: :shortlisted)
