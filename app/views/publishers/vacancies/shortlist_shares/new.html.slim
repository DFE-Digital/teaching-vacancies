- content_for :page_title_prefix, t(".page_title")

= govuk_back_link text: t("buttons.back"), href: organisation_job_job_applications_path(vacancy.id, anchor: :shortlisted)

.govuk-grid-row
  .govuk-grid-column-two-thirds
    span.govuk-caption-l = vacancy.job_title
    h1.govuk-heading-l = t(".heading")

    p.govuk-body = t(".description", count: @job_applications.count)

    = govuk_inset_text do
      ul.govuk-list.govuk-list--bullet
        - @job_applications.each do |job_application|
          li = job_application.name

    = form_with model: @form,
      url: review_organisation_job_shortlist_share_path(vacancy.id),
      method: :post do |form|
      = form.govuk_error_summary

      - @job_application_ids.each do |job_application_id|
        = form.hidden_field :job_application_ids, multiple: true, value: job_application_id

      = form.govuk_email_field :email,
        label: { text: t(".email_label"), size: "m" },
        hint: { text: t(".email_hint") },
        width: "two-thirds",
        autocomplete: "email"

      = form.govuk_submit t("buttons.continue")

    = govuk_link_to t("buttons.cancel"), organisation_job_job_applications_path(vacancy.id, anchor: :shortlisted)
