- content_for :page_title_prefix, page_title_prefix(step_process, form)

= render "back_path", back_path: back_path

= vacancy_form_page_heading(vacancy, step_process, sub_caption: { text: "Select all that apply", class: "govuk-!-margin-top-4 govuk-!-margin-bottom-4" })

= form_for form, url: wizard_path(current_step), method: :patch do |f|
  = f.govuk_error_summary

  = f.govuk_collection_check_boxes :phases, Vacancy.phases.keys, :to_s, :to_s, legend: { hidden: true }

  = render "publishers/vacancies/vacancy_form_partials/submit", f: f
