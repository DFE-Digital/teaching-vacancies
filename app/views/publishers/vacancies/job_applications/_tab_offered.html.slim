= govuk_inset_text do
  p = t("tabs.offered.offered_inset")

= render TabPanelComponent.new(tab_name:,
                               vacancy:,
                               form:,
                               candidates: candidates.fetch("offered"),
                               displayed_fields: %i[name email_address offered_at status],
                               button_group: %i[export declined])

= govuk_section_break(visible: true, size: "xl")

.tab-declined
  h2.govuk-heading-m = t("tabs.declined.heading")

  - if candidates.fetch("declined").any?
    = render CandidatesTableComponent.new(vacancy:,
                                          candidates: candidates.fetch("declined"),
                                          displayed_fields: %i[name email_address declined_at])
  - else
    = empty_section title: t("tabs.declined.none")
