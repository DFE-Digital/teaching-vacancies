- content_for :page_title_prefix, "Job preferences: locations"
- content_for :breadcrumbs do
  = govuk_back_link text: t("buttons.back"), href: jobseekers_job_preferences_locations_path

h1.govuk-heading-xl
  span.govuk-caption-xl Delete location
  | Confirm that you want to delete #{@location[:name]} (#{t("jobs.search.number_of_miles", count: @location[:radius].to_i)})
= form_for @delete_form, url: jobseekers_job_preferences_location_path(@location[:id]), method: :delete do |f|
  = f.hidden_field :action, value: :delete
  = f.govuk_submit "Delete this location"
  p = f.link_to "Cancel", escape_path
