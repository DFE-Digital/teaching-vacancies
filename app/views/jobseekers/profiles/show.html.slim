- content_for :page_title_prefix, t(".page_title")

h1.govuk-heading-xl
  = t(".page_title")
  = govuk_tag(text: t(".active"), colour: "green", classes: "vertical-align-middle govuk-!-margin-left-1") if @profile.active?

div class="govuk-grid-row govuk-heading-l govuk-!-margin-bottom-4"
  .govuk-grid-column-one-third
    .dfe-card.dfe-card-container
      h2.govuk-heading-m
        = govuk_link_to t("sub_nav.jobseekers.saved_jobs"), jobseekers_saved_jobs_path

  .govuk-grid-column-one-third
    .dfe-card.dfe-card-container
      h2.govuk-heading-m
        = govuk_link_to t("sub_nav.jobseekers.job_alerts"), jobseekers_subscriptions_path

  .govuk-grid-column-one-third
    .dfe-card.dfe-card-container
      h2.govuk-heading-m
        = govuk_link_to t("nav.create_a_job_alert"), new_subscription_path

- @sections.each do |section|
  h2.govuk-heading-m class="govuk-!-padding-top-6"
    = section[:title]

  - if section.fetch(:display_summary).call(@profile)
    = render(partial: "jobseekers/profiles/#{section[:key]}/summary", locals: { profile: @profile })
  - else
    p = govuk_link_to section[:link_text], instance_exec(&section[:page_path])

= govuk_details summary_text: t(".one_login_banner.header") do
  p.govuk-body = t(".one_login_banner.paragraph1")
  p.govuk-body = t(".one_login_banner.paragraph2_html", link: govuk_link_to(t(".one_login_banner.transfer_profile_link_text"), new_jobseekers_request_account_transfer_email_path))
