- content_for :page_title_prefix, t(".page_title")

- sections = { applications: jobseekers_job_applications_path,
    saved_jobs: jobseekers_saved_jobs_path,
    job_alerts: jobseekers_subscriptions_path,
    notifications: jobseekers_notifications_path,
    help: help_jobseekers_account_path,
    sign_out: jobseeker_logout_uri.to_s }

h1.govuk-heading-l = t(".page_title")

p.govuk-body-l = t(".lead_in")

ul.govuk-list
  - sections.each do |key, path|
    li class="govuk-section-break govuk-section-break--visible govuk-!-padding-top-3 govuk-!-padding-bottom-3"
      h2.govuk-heading-s class="govuk-!-margin-bottom-1" = govuk_link_to t(".#{key}.link"), path
      p.govuk-body class="govuk-!-margin-bottom-0" = t(".#{key}.description")
