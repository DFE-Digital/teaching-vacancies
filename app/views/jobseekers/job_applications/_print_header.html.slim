header.print-header
  .print-header__text
    p.print-header__caption = caption
    h1.print-header__applicant-name class=("print-header__applicant-name--blank" if applicant_name.blank?)
      - if applicant_name.present?
        = applicant_name
      - else
        span.govuk-visually-hidden = title
  = image_tag "TVS-logo.png", class: "print-header__logo", alt: t("app.title")
