- content_for :page_title_prefix, t(".page_title")
- content_for :meta_no_index do
  meta name="robots" content="noindex,nofollow"

ruby:
  personal_detail_labels = [
    t("helpers.label.jobseekers_job_application_personal_details_form.first_name"),
    t("helpers.label.jobseekers_job_application_personal_details_form.last_name"),
    t("helpers.label.jobseekers_job_application_personal_details_form.previous_names_optional"),
    t("helpers.legend.jobseekers_job_application_personal_details_form.your_address"),
    t("helpers.label.jobseekers_job_application_personal_details_form.phone_number"),
    t("helpers.label.jobseekers_job_application_personal_details_form.email_address"),
    t("helpers.legend.jobseekers_job_application_declarations_form.has_right_to_work_in_uk"),
    t("helpers.label.jobseekers_job_application_personal_details_form.working_patterns"),
    t("helpers.label.jobseekers_job_application_personal_details_form.national_insurance_number_review"),
    t("helpers.legend.jobseekers_job_application_personal_details_form.working_pattern_details"),
  ]
  professional_status_labels = [
    t("helpers.legend.jobseekers_job_application_professional_status_form.qualified_teacher_status"),
    t("jobseekers.job_application.age_range_and_subject"),
    t("helpers.label.jobseekers_job_application_personal_details_form.teacher_reference_number_review"),
    t("helpers.legend.jobseekers_job_application_professional_status_form.is_statutory_induction_complete"),
  ]
  secondary_qualification_labels = [
    t(".qualification_fields.secondary_qualification"),
    t(".qualification_fields.subject"),
    t(".qualification_fields.grade"),
    t(".qualification_fields.date_completed"),
  ]
  degree_qualification_labels = [
    t(".qualification_fields.qualification_name"),
    t(".qualification_fields.subject"),
    t(".qualification_fields.institution"),
    t(".qualification_fields.grade"),
    t(".qualification_fields.date_completed"),
  ]
  qualification_groups = [
    { heading: t("helpers.label.jobseekers_qualifications_category_form.category_options.postgraduate"), count: 1, labels: degree_qualification_labels },
    { heading: t("helpers.label.jobseekers_qualifications_category_form.category_options.undergraduate"), count: 1, labels: degree_qualification_labels },
    { heading: t("helpers.label.jobseekers_qualifications_category_form.category_options.a_level"), count: 3, labels: secondary_qualification_labels },
    { heading: t("helpers.label.jobseekers_qualifications_category_form.category_options.gcse"), count: 5, labels: secondary_qualification_labels },
  ]

header.print-header
  .print-header__text
    p.print-header__caption = t("jobseekers.job_applications.caption", job_title: @vacancy.job_title, organisation: @vacancy.organisation_name)
    h1.print-header__applicant-name
      span.govuk-visually-hidden = t(".title")
  = image_tag "TVS-logo.png", class: "print-header__logo", alt: t("app.title")

p.print-introduction = t("jobseekers.job_applications.show.consent_text")

section.print-section
  h2.print-section__heading = t("jobseekers.job_applications.show.personal_details.heading")
  .print-table
    - personal_detail_labels.each do |label|
      .print-table__row
        p.print-table__label = label
        .print-table__writing-space aria-hidden="true"

section.print-section
  h2.print-section__heading = t("jobseekers.job_applications.show.professional_status.heading")
  .print-table
    - professional_status_labels.each do |label|
      .print-table__row
        p.print-table__label = label
        .print-table__writing-space aria-hidden="true"

section.print-section
  h2.print-section__heading = t("jobseekers.job_applications.show.qualifications.heading")
  - qualification_groups.each do |group|
    .print-subsection
      h3.print-subsection__heading = group[:heading]
      - group[:count].times do
        article.print-qualification
          .print-table
            - group[:labels].each do |label|
              .print-table__row
                p.print-table__label = label
                .print-table__writing-space aria-hidden="true"
