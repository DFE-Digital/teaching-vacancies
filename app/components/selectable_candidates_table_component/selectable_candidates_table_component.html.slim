= govuk_table(html_attributes: { data: { controller: "multi-select", id_prefix: } }) do |table|
  - table.with_head do |head|
    - head.with_row do |row|
      / Left empty for the multi-select JavaScript to add the "Select all" checkbox
      - row.with_cell(html_attributes: { id: "#{id_prefix}select-all" })
      - @displayed_fields.each do |field|
        - row.with_cell(text: t("tabs.headers.#{field}"))

  - table.with_body do |body|
    - @candidates.each_with_index do |job_application, index|
      - body.with_row(html_attributes: { class: "application-#{job_application.status}" }) do |row|
        - row.with_cell(text: checkbox_cell(job_application, index))
        - @displayed_fields.each do |field|
          - row.with_cell(text: cell(job_application, field), html_attributes: { class: field.to_s })
