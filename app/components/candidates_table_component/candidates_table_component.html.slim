= govuk_table do |table|
  - table.with_head do |head|
    - head.with_row do |row|
      - @displayed_fields.each do |field|
        - row.with_cell(text: t("tabs.headers.#{field}"))

  - table.with_body do |body|
    - @candidates.each do |job_application|
      - body.with_row(html_attributes: { class: "application-#{job_application.status}" }) do |row|
        - @displayed_fields.each do |field|
          - row.with_cell(text: cell(job_application, field), html_attributes: { class: field.to_s })
