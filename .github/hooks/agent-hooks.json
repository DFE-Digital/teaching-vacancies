{
  "version": 1,
  "hooks": {
    "preToolUse": [
      { "type": "command", "bash": ".claude/hooks/run-ruby.sh .claude/hooks/guard-bash.rb", "timeoutSec": 10 }
    ],
    "postToolUse": [
      { "type": "command", "bash": ".claude/hooks/run-ruby.sh .claude/hooks/lint-edited-file.rb", "timeoutSec": 120 }
    ]
  }
}
