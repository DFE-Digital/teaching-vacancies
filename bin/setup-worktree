#!/usr/bin/env bash
# Prepares a fresh git worktree so that bin/dev and the specs work: symlinks the git-ignored
# env files from the main checkout, installs dependencies and builds the git-ignored JavaScript and
# CSS bundles that the specs need. Safe to re-run.
set -euo pipefail

cd "$(dirname "$0")/.."

main_checkout="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"

if [ "$main_checkout" = "$(pwd)" ]; then
  echo "This is the main checkout, nothing to do."
  exit 0
fi

# Git-ignored files that a worktree doesn't get. Contents are never read or printed.
for file in .env .env.development.local .env.test.local mise.local.toml; do
  if [ -e "$main_checkout/$file" ] && [ ! -e "$file" ] && [ ! -L "$file" ]; then
    ln -s "$main_checkout/$file" "$file"
    echo "Linked $file"
  fi
done

corepack enable
yarn install
# A global safe.bareRepository=explicit git setting stops Bundler using its cached clones of git-sourced
# gems, so allow bare repositories for this one command only (this does not change your git config).
bundle check > /dev/null || GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.bareRepository GIT_CONFIG_VALUE_0=all bundle install
yarn build
yarn build:css
